class Arraymul {
    public int arraySign(int[] nums) {
        int negativeCount = 0; 
        for (int i = 0; i < nums.length; i++) { 
            if (nums[i] == 0) { 
                return 0; 
                } 
                if (nums[i] < 0)
                 { negativeCount++; 
                 } 
                 } if (negativeCount % 2 == 0)
                  { return 1; 
                  } else {
                     return -1; } 
                     } 
                     
        
    
    public static void main(String [] args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int[] nums=new int[n];
        for(int i=0;i<n;i++){
            nums[i]=sc.nextInt();
        }
        Arraymul so=new Arraymul();
        System.out.println(so.arraySign(nums));
    }
}
